# ── Discord（必需） ──────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# 可选：将命令注册到单个服务器，而不是全局注册。
# DISCORD_GUILD_ID=

# ── ER:LC API 包（/erlc 和 /erlcadmin 必需） ─────────────────────────────────
# 加入您的私有服务器，打开设置，在 ER:LC API 部分搜索 "API key"。
# 复制到此处。您也可以在机器人运行后使用 /erlcsetup apikey 进行设置。
# ERLC_API_KEY=

# ── 驗證機器人（選填） ───────────────────────────────────────────────────────
# 封禁請求核准時若沒有填關聯的 Discord 使用者，機器人會依序查詢
# Bloxlink → RoWifi → Rover，把 Roblox 帳號對應的 Discord 使用者找出來。
# 建議用 /erlcsetup verifykey 直接在 Discord 設定：金鑰存在該伺服器自己的設定裡，
# 每個伺服器都能用自己的金鑰，設定後立即生效、不需重新部署。
# 下面的環境變數是「全域後備」，只有在該伺服器沒有用指令設定金鑰時才會使用。
#
# Bloxlink：v4 API 需要 API 金鑰，沒有金鑰的查詢會被拒絕。
#   到 https://blox.link/dashboard/user/developer 為「要查詢的伺服器」產生 Guild API Key；
#   金鑰綁定產生它的伺服器，拿去查別的伺服器會回 Guild ID does not match API Key。
# BLOXLINK_API_KEY=
#
# RoWifi：https://dashboard.rowifi.xyz/ → Tokens 頁產生 API Token
# ROWIFI_API_KEY=
#
# RoVer：https://rover.link/ → Manage Servers → 該伺服器 → Bot Developer API
# ROVER_API_KEY=
#
# 設定環境變數後需重新啟動機器人，並用 /erlcsetup diagnose 確認金鑰是否已生效。

# ── 可选 ────────────────────────────────────────────────────────────────────
# PERSISTENT_DATA_DIR=   （由 VybeBot Cloud 设置；回退到 ./.data）
# LOG_LEVEL=
# NODE_ENV=
